### MiniCRM example requests (VS Code REST Client extension)
### Click "Send Request" above a request. "###" starts a new request.
### Run "Log in" first in each section; later requests reuse its token automatically.

@local = http://localhost:3000
@prod = https://minicrm-gd2p.onrender.com

### ==================================================
### LOCAL (npm run dev)
### ==================================================

### Health
GET {{local}}/health

### Database health
GET {{local}}/health/db

### Register an organization and its owner
POST {{local}}/auth/register
Content-Type: application/json

{
  "organizationName": "Local Co",
  "name": "Ananya",
  "email": "ananya@local.example.com",
  "password": "local-password-123"
}

### Log in
# @name localLogin
POST {{local}}/auth/login
Content-Type: application/json

{
  "email": "ananya@local.example.com",
  "password": "local-password-123"
}

### No token: 401 AUTH_REQUIRED
GET {{local}}/leads

### Create a lead
# @name localLead
POST {{local}}/leads
Authorization: Bearer {{localLogin.response.body.accessToken}}
Content-Type: application/json

{
  "name": "Ravi Kumar",
  "company": "Globex",
  "email": "ravi@globex.example.com"
}

### List leads (search, sort, page)
GET {{local}}/leads?q=globex&sort=name&order=asc&limit=10&page=1
Authorization: Bearer {{localLogin.response.body.accessToken}}

### Change the lead's status (writes a history row)
PATCH {{local}}/leads/{{localLead.response.body.id}}
Authorization: Bearer {{localLogin.response.body.accessToken}}
Content-Type: application/json

{
  "status": "contacted"
}

### Status history
GET {{local}}/leads/{{localLead.response.body.id}}/history
Authorization: Bearer {{localLogin.response.body.accessToken}}

### Add a contact
POST {{local}}/leads/{{localLead.response.body.id}}/contacts
Authorization: Bearer {{localLogin.response.body.accessToken}}
Content-Type: application/json

{
  "name": "Priya Shah",
  "email": "priya@globex.example.com"
}

### Add a deal
POST {{local}}/leads/{{localLead.response.body.id}}/deals
Authorization: Bearer {{localLogin.response.body.accessToken}}
Content-Type: application/json

{
  "title": "Annual plan",
  "valueCents": 250000
}

### Log an activity
POST {{local}}/leads/{{localLead.response.body.id}}/activities
Authorization: Bearer {{localLogin.response.body.accessToken}}
Content-Type: application/json

{
  "type": "call",
  "note": "Discussed pricing"
}

### Add a reminder (any timezone in, UTC out)
POST {{local}}/leads/{{localLead.response.body.id}}/reminders
Authorization: Bearer {{localLogin.response.body.accessToken}}
Content-Type: application/json

{
  "title": "Follow up",
  "dueAt": "2030-01-15T09:00:00+05:30"
}

### Add a member (owners only)
POST {{local}}/users
Authorization: Bearer {{localLogin.response.body.accessToken}}
Content-Type: application/json

{
  "name": "Carol",
  "email": "carol@local.example.com",
  "password": "member-password-123"
}

### List users
GET {{local}}/users
Authorization: Bearer {{localLogin.response.body.accessToken}}

### Malformed JSON: 400 INVALID_JSON
POST {{local}}/leads
Authorization: Bearer {{localLogin.response.body.accessToken}}
Content-Type: application/json

{ "name": "Broken JSON",

### Unknown route: 404 ROUTE_NOT_FOUND
GET {{local}}/this-route-does-not-exist


### ==================================================
### PRODUCTION (Render + Neon)
### ==================================================

### Health
GET {{prod}}/health

### Database health
GET {{prod}}/health/db

### Register an organization
POST {{prod}}/auth/register
Content-Type: application/json

{
  "organizationName": "Demo Co",
  "name": "Ananya",
  "email": "ananya@demo.example.com",
  "password": "demo-password-123"
}

### Log in (the token is reused automatically below)
# @name login
POST {{prod}}/auth/login
Content-Type: application/json

{
  "email": "ananya@demo.example.com",
  "password": "demo-password-123"
}

### Create a lead (send "Log in" first)
POST {{prod}}/leads
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "name": "First Online Lead",
  "company": "Internet Co",
  "email": "lead@internet.example.com"
}

### List leads
GET {{prod}}/leads
Authorization: Bearer {{login.response.body.accessToken}}
